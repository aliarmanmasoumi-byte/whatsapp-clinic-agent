# Copy to .env and fill in. .env is gitignored.

# --- Meta / WhatsApp Cloud API ----------------------------------------------
META_ACCESS_TOKEN=          # permanent system-user token (starts EAA…)
WABA_ID=                    # WhatsApp Business Account id
WHATSAPP_PHONE_NUMBER_ID=
META_APP_ID=
WHATSAPP_NUMBER=            # the number patients text, E.164

# --- n8n ---------------------------------------------------------------------
N8N_URL=                    # https://n8n.example.com
N8N_API_KEY=
N8N_WORKFLOW_ID=            # the booking backend workflow
N8N_BOOKING_WEBHOOK=        # ${N8N_URL}/webhook/<path>

# Shared secret every tool call sends as x-webhook-token; the backend rejects
# anything without it.
WEBHOOK_TOKEN=

# --- model -------------------------------------------------------------------
OPENAI_API_KEY=

# --- diagnostics -------------------------------------------------------------
# Default recipient for test sends. Keep this a dummy number.
TEST_PHONE=
